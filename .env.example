# Browser-safe canonical origin used for social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional read-only AI provider. Keep secret values out of source control.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Local server-side AWS profile mapping. Credentials remain in ~/.aws.
AWS_CONFIG_DIR=/home/your-user/.aws
AWS_PROFILE_NILKAMAL=nilkamal
AWS_PROFILE_GCPL=gcpl
AWS_PROFILE_SWASTIKS=swastiks
AWS_PROFILE_FUSION=fusion
